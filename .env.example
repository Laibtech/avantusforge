# ========================================================
# AvantusForge - Environment Configuration Template
# ========================================================

# App Base URL
NEXT_PUBLIC_SITE_URL=https://avantusforge.com

# Database Connection (MySQL / MariaDB)
# Optional in development: if MySQL is offline, the app seamlessly uses JSON dual-persistence in /data
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=avantus_db

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Admin Session Security
ADMIN_SESSION_SECRET=avantus_enterprise_super_secret_key_change_in_production

